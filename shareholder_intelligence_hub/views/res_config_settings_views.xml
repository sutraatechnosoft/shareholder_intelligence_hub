<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_shareholder_intelligence_hub" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.shareholder.intelligence.hub</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Executive Dashboard"
                     string="Executive Dashboard" data-key="shareholder_intelligence_hub"
                     groups="shareholder_intelligence_hub.group_executive_shareholder_admin">
                    <h2>Objectives and Methodology</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="dashboard_ebitda_target"/>
                                <div class="text-muted">
                                    Management benchmark threshold for EBITDA margin.
                                </div>
                                <div class="content-group">
                                    <field name="dashboard_ebitda_target" class="o_light_label"/> %
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="dashboard_cash_runway_target_months"/>
                                <div class="text-muted">
                                    Target runway months based on current burn rate.
                                </div>
                                <div class="content-group">
                                    <field name="dashboard_cash_runway_target_months" class="o_light_label"/> months
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="dashboard_fx_method"/>
                                <div class="text-muted">
                                    Method used when consolidating subsidiaries with a different currency.
                                </div>
                                <div class="content-group">
                                    <field name="dashboard_fx_method" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <field name="dashboard_eliminate_intercompany" class="oe_inline"/>
                                <label for="dashboard_eliminate_intercompany"/>
                                <div class="text-muted">
                                    Exclude intercompany transactions from the consolidation.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>