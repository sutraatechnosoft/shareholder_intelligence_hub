<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dashboard_kpi_snapshot_list" model="ir.ui.view">
        <field name="name">dashboard.kpi.snapshot.list</field>
        <field name="model">dashboard.kpi.snapshot</field>
        <field name="arch" type="xml">
            <list string="KPI Snapshots">
                <field name="snapshot_date"/>
                <field name="company_id"/>
                <field name="revenue_ytd"/>
                <field name="ebitda"/>
                <field name="ebitda_margin"/>
                <field name="roe"/>
                <field name="cash_flow_available"/>
            </list>
        </field>
    </record>

    <record id="view_dashboard_kpi_snapshot_form" model="ir.ui.view">
        <field name="name">dashboard.kpi.snapshot.form</field>
        <field name="model">dashboard.kpi.snapshot</field>
        <field name="arch" type="xml">
            <form string="KPI Snapshot">
                <header>
                    <button name="action_recompute_kpis" 
                            string="Recompute KPIs" 
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-refresh"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="snapshot_date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="revenue_ytd" readonly="True"/>
                            <field name="ebitda" readonly="True"/>
                            <field name="ebitda_margin" readonly="True"/>
                            <field name="roe" readonly="True"/>
                            <field name="roa" readonly="True"/>
                            <field name="cash_flow_available" readonly="True"/>
                            <field name="runway_months" readonly="True"/>
                        </group>
                    </group>
                    <group string="Debt Aging">
                        <group string="Accounts Receivable">
                            <field name="ar_aging_0_30" readonly="True"/>
                            <field name="ar_aging_31_60" readonly="True"/>
                            <field name="ar_aging_61_90" readonly="True"/>
                            <field name="ar_aging_90_plus" readonly="True"/>
                        </group>
                        <group string="Accounts Payable">
                            <field name="ap_aging_0_30" readonly="True"/>
                            <field name="ap_aging_31_60" readonly="True"/>
                            <field name="ap_aging_61_90" readonly="True"/>
                            <field name="ap_aging_90_plus" readonly="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dashboard_kpi_snapshot" model="ir.actions.act_window">
        <field name="name">KPI Snapshots</field>
        <field name="res_model">dashboard.kpi.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>