<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="shareholder_intelligence_hub.KpiCard">
        <div class="sih-kpi-card" t-attf-class="sih-kpi-card--{{props.status}}">
            <div class="sih-kpi-card__title" t-esc="props.title"/>
            <div class="sih-kpi-card__value" t-esc="props.value"/>
            <div class="sih-kpi-card__subtitle" t-if="props.subtitle" t-esc="props.subtitle"/>
        </div>
    </t>
    <t t-name="shareholder_intelligence_hub.ChartWaterfall">
        <div class="sih-chart-waterfall">
            <canvas t-ref="canvas"/>
        </div>
    </t>
    <t t-name="shareholder_intelligence_hub.ChartAging">
        <div class="sih-chart-aging">
            <canvas t-ref="canvas"/>
        </div>
    </t>
    <t t-name="shareholder_intelligence_hub.Dashboard">
        <div class="sih-dashboard">
            <div class="sih-dashboard__header">
                <h2>KPIX Dashboard</h2>
                <select t-if="state.companies.length"
                        t-on-change="onCompanyChange"
                        class="sih-dashboard__company-select">
                    <t t-foreach="state.companies" t-as="company" t-key="company.id">
                        <option t-att-value="company.id"
                                t-att-selected="company.id === state.selectedCompanyId">
                            <t t-esc="company.name"/>
                        </option>
                    </t>
                </select>
            </div>
            <div t-if="state.loading" class="sih-dashboard__loading">
                Loading KPIs...
            </div>
            <div t-elif="!state.found" class="sih-dashboard__empty">
                No KPI snapshot has been calculated for this company yet. The cron runs hourly — wait for the next cycle or trigger it manually from Settings → Technical → Scheduled Actions.
            </div>
            <div t-else="" class="sih-dashboard__content">
                <div class="sih-dashboard__cards">
                    <KpiCard title="'YTD Revenue'"
                             value="this.formatCurrency(state.data.kpis.revenue_ytd)"
                             subtitle="this.formatYoY(state.data.kpis.revenue_yoy_growth)"/>
                    <KpiCard title="'EBITDA Margin'"
                             value="this.formatPercent(state.data.kpis.ebitda_margin)"
                             subtitle="'Target: &gt; ' + this.formatPercent(state.data.kpis.ebitda_target) + ' · ' + this.formatYoY(state.data.kpis.ebitda_yoy_growth)"
                             status="state.data.kpis.ebitda_margin_on_target ? 'good' : 'warning'"/>
                    <KpiCard title="'Available Cash Flow'"
                             value="this.formatCurrency(state.data.kpis.cash_flow_available)"
                             subtitle="'Runway: ' + state.data.kpis.runway_months.toFixed(1) + ' mos' + ' · ' + this.formatYoY(state.data.kpis.cash_flow_yoy_growth)"/>
                    <KpiCard title="'ROE'"
                             value="this.formatPercent(state.data.kpis.roe)"
                             subtitle="this.formatYoYPoints(state.data.kpis.roe_yoy_delta)"/>
                </div>
                <div class="sih-dashboard__waterfall">
                    <h3>Profit &amp; Loss (P&amp;L)</h3>
                    <ChartWaterfall labels="waterfallLabels" values="waterfallValues" isTotal="waterfallIsTotal"/>
                </div>
                <div class="sih-dashboard__aging row g-3 mt-2">
                    <div class="col-md-6">
                        <div class="card p-3">
                            <div style="height: 250px;">
                                <ChartAging title="'Accounts Receivable (AR) Aging'"
                                            labels="agingLabels"
                                            values="arAgingValues"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card p-3">
                            <div style="height: 250px;">
                                <ChartAging title="'Accounts Payable (AP) Aging'"
                                            labels="agingLabels"
                                            values="apAgingValues"
                                            color="'#dc3545'"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>