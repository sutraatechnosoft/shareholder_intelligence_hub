<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_dashboard_kpi_snapshot_shareholder_company"
                model="ir.rule">
            <field name="name">
                Dashboard KPI Snapshot: allowed companies
            </field>

            <field name="model_id"
                   ref="model_dashboard_kpi_snapshot"/>

            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>

            <field name="groups"
                   eval="[(4, ref('group_executive_shareholder'))]"/>

            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_dashboard_kpi_snapshot_admin_all"
                model="ir.rule">
            <field name="name">
                Dashboard KPI Snapshot: admin sees all
            </field>

            <field name="model_id"
                   ref="model_dashboard_kpi_snapshot"/>

            <field name="domain_force">
                [(1, '=', 1)]
            </field>

            <field name="groups"
                   eval="[(4, ref('group_executive_shareholder_admin'))]"/>

            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>